# Lección 1. recursion_limit cuenta supersteps, el de START incluido.
# Newton para x² − 2 desde x₀ = 1 usa cinco supersteps (0 a 4): con L = 4 no alcanza y con L = 5 llega a END.
# intervalo: 2800
...@../estilo

vars: {d2-config: {layout-engine: dagre}}

classes: {
  superstep: {
    width: 92
    height: 64
    style: {fill: ${nodo}; stroke: ${borde-nodo}; stroke-width: 2; border-radius: 10; font: mono; font-size: 15; font-color: ${tinta}}
  }
  cuenta: {
    width: 92
    height: 64
    style: {fill: ${turquesa-suave}; stroke: ${turquesa}; stroke-width: 3; border-radius: 10; font: mono; font-size: 15; font-color: ${tinta}}
  }
  excede: {
    width: 92
    height: 64
    style: {fill: ${rosa-suave}; stroke: ${rosa}; stroke-width: 3; border-radius: 10; font: mono; font-size: 15; font-color: ${tinta}}
  }
  fin: {
    shape: oval
    width: 92
    height: 64
    style: {fill: ${tarjeta}; stroke: ${borde-nodo}; stroke-width: 2; font: mono; font-size: 14; font-color: ${suave}}
  }
  fin-activo: {
    shape: oval
    width: 92
    height: 64
    style: {fill: ${turquesa-suave}; stroke: ${turquesa}; stroke-width: 3; font: mono; font-size: 14; font-color: ${tinta}}
  }
}

grid-columns: 1
grid-gap: 22

linea: {
  class: invisible
  grid-columns: 6
  grid-gap: 14

  t0: "0\nSTART" {class: superstep}
  t1: "1\npaso" {class: superstep}
  t2: "2\npaso" {class: superstep}
  t3: "3\npaso" {class: superstep}
  t4: "4\npaso" {class: superstep}
  fin: END {class: fin}
}

explica: "x² − 2 desde x₀ = 1: cinco supersteps, del 0 al 4." {class: paso; width: 600; height: 56}

steps: {
  1: {
    linea.t0.class: cuenta
    linea.t1.class: cuenta
    linea.t2.class: cuenta
    linea.t3.class: cuenta
    linea.t4.class: excede
    explica.label: "recursion_limit = 4: caben los supersteps 0 a 3.\nEl 4 excede el límite → GraphRecursionError."
  }
  2: {
    linea.t4.class: cuenta
    linea.fin.class: fin-activo
    explica.label: "recursion_limit = 5: caben los cinco\ny la ejecución llega a END."
  }
}
