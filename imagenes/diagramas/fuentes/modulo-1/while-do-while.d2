# Lección 1. while y do … while en diagrama de flujo y en LangGraph.
# Con while dos flechas entran al rombo, así que la arista condicional c sale de START y de paso; con do … while la primera es una arista fija.
...@../estilo

vars: {d2-config: {layout-engine: dagre}}

classes: {
  linea: {
    width: 200
    height: 28
    style: {fill: ${nodo}; stroke: ${borde}; stroke-width: 1; border-radius: 6; font: mono; font-size: 14; bold: false; font-color: ${tinta}}
  }
  rombo: {
    shape: diamond
    width: 100
    height: 54
    style: {fill: ${nodo}; stroke: ${ambar}; stroke-width: 3; font: mono; font-size: 14; font-color: ${tinta}}
  }
  caja: {
    width: 160
    height: 30
    style: {fill: ${nodo}; stroke: ${borde-nodo}; stroke-width: 2; border-radius: 10; font: mono; font-size: 14; font-color: ${tinta}}
  }
  cond-amb: {
    style: {stroke: ${ambar}; stroke-width: 2; stroke-dash: 4; font: mono; font-size: 13; font-color: ${suave}}
  }
  entra-amb: {
    style: {stroke: ${ambar}; stroke-width: 3; font: mono; font-size: 13; font-color: ${suave}}
  }
  fija-rosa: {
    style: {stroke: ${rosa}; stroke-width: 3; font: mono; font-size: 13; font-color: ${suave}}
  }
  fila: {
    width: 90
    shape: text
    style: {font-size: 16; bold: true; font-color: ${tinta}}
  }
}

grid-columns: 1
grid-gap: 20

while: "while: pregunta antes de la caja" {
  class: grupo
  label.near: top-left
  grid-columns: 1
  grid-gap: 8

  par: {
    class: invisible
    grid-columns: 2
    grid-gap: 24

    flujo: "diagrama de flujo" {
      class: panel
      label.near: top-center
      direction: down

      i: "inicio" {class: extremo; width: 84; height: 30}
      c: "b ≠ 0" {class: rombo}
      a: "a, b ← b, a mod b" {class: caja}
      z: "fin" {class: extremo; width: 84; height: 30}
      i -> c {class: entra-amb}
      c -> a: "sí" {class: arista}
      a -> c {class: entra-amb}
      c -> z: "no" {class: arista}
    }
    lg: "LangGraph" {
      class: panel
      label.near: top-center
      direction: down

      i: START {class: extremo; width: 84; height: 30}
      a: "paso" {class: nodo; width: 100; height: 32; style.font-size: 14}
      z: END {class: extremo; width: 84; height: 30}
      i -> a: "c" {class: cond-amb}
      i -> z: "c" {class: cond-amb}
      a -> a: "c" {class: cond-amb}
      a -> z: "c" {class: cond-amb}
    }
  }
  nota: "Dos flechas entran al rombo: c sale de START y de paso." {class: nota}
}

dowhile: "do … while: pregunta después" {
  class: grupo
  label.near: top-left
  grid-columns: 1
  grid-gap: 8

  par: {
    class: invisible
    grid-columns: 2
    grid-gap: 24

    flujo: "diagrama de flujo" {
      class: panel
      label.near: top-center
      direction: down

      i: "inicio" {class: extremo; width: 84; height: 30}
      a: "a, b ← b, a mod b" {class: caja}
      c: "b ≠ 0" {class: rombo}
      z: "fin" {class: extremo; width: 84; height: 30}
      i -> a {class: fija-rosa}
      a -> c {class: arista}
      c -> a: "sí" {class: arista}
      c -> z: "no" {class: arista}
    }
    lg: "LangGraph" {
      class: panel
      label.near: top-center
      direction: down

      i: START {class: extremo; width: 84; height: 30}
      a: "paso" {class: nodo; width: 100; height: 32; style.font-size: 14}
      z: END {class: extremo; width: 84; height: 30}
      i -> a {class: fija-rosa}
      a -> a: "c" {class: cond-amb}
      a -> z: "c" {class: cond-amb}
    }
  }
  nota: "START → paso fija: paso corre antes de preguntar.\nCon b₀ = 0, a % 0 lanza ZeroDivisionError." {class: nota}
}
