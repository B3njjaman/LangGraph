# Lección 1. Las tres formas de control (secuencia, selección e iteración) en programa, diagrama de flujo y grafo de LangGraph.
# El ámbar une cada rombo con las aristas condicionales que lo reemplazan en LangGraph.
...@../estilo

vars: {d2-config: {layout-engine: dagre}}

classes: {
  linea: {
    height: 28
    style: {fill: ${nodo}; stroke: ${borde}; stroke-width: 1; border-radius: 6; font: mono; font-size: 14; bold: false; font-color: ${tinta}}
  }
  rombo: {
    shape: diamond
    width: 100
    height: 54
    style: {fill: ${nodo}; stroke: ${ambar}; stroke-width: 3; font: mono; font-size: 14; font-color: ${tinta}}
  }
  caja: {
    width: 160
    height: 30
    style: {fill: ${nodo}; stroke: ${borde-nodo}; stroke-width: 2; border-radius: 10; font: mono; font-size: 14; font-color: ${tinta}}
  }
  cond-amb: {
    style: {stroke: ${ambar}; stroke-width: 2; stroke-dash: 4; font: mono; font-size: 13; font-color: ${suave}}
  }
  entra-amb: {
    style: {stroke: ${ambar}; stroke-width: 3; font: mono; font-size: 13; font-color: ${suave}}
  }
  fija-rosa: {
    style: {stroke: ${rosa}; stroke-width: 3; font: mono; font-size: 13; font-color: ${suave}}
  }
  fila: {
    width: 90
    shape: text
    style: {font-size: 16; bold: true; font-color: ${tinta}}
  }
}


grid-columns: 1
grid-gap: 16

r1: "secuencia" {
  class: grupo
  label.near: top-left
  grid-columns: 3
  grid-gap: 14

  p: "programa" {
    class: panel
    label.near: top-center
    grid-columns: 1
    grid-gap: 6
    l1: "y = x + 1          ​" {class: linea}
    l2: "z = 2 * y          ​" {class: linea}
  }
  f: "diagrama de flujo" {
    class: panel
    label.near: top-center
    direction: down
    i: "inicio" {class: extremo; width: 84; height: 30}
    a: "y ← x + 1" {class: caja}
    b: "z ← 2y" {class: caja}
    z: "fin" {class: extremo; width: 84; height: 30}
    i -> a {class: arista}
    a -> b {class: arista}
    b -> z {class: arista}
  }
  g: "LangGraph" {
    class: panel
    label.near: top-center
    direction: down
    i: START {class: extremo; width: 84; height: 30}
    a: "sumar" {class: nodo; width: 100; height: 32; style.font-size: 14}
    b: "duplicar" {class: nodo; width: 100; height: 32; style.font-size: 14}
    z: END {class: extremo; width: 84; height: 30}
    i -> a {class: arista}
    a -> b {class: arista}
    b -> z {class: arista}
  }
}

r2: "selección" {
  class: grupo
  label.near: top-left
  grid-columns: 3
  grid-gap: 14

  p: "programa" {
    class: panel
    label.near: top-center
    grid-columns: 1
    grid-gap: 6
    l1: "if x < 0:          ​" {class: linea}
    l2: "    x = -x         ​" {class: linea}
  }
  f: "diagrama de flujo" {
    class: panel
    label.near: top-center
    direction: down
    i: "inicio" {class: extremo; width: 84; height: 30}
    c: "x < 0" {class: rombo}
    a: "x ← −x" {class: caja}
    z: "fin" {class: extremo; width: 84; height: 30}
    i -> c {class: arista}
    c -> a: "sí" {class: arista}
    a -> z {class: arista}
    c -> z: "no" {class: arista}
  }
  g: "LangGraph" {
    class: panel
    label.near: top-center
    direction: down
    i: START {class: extremo; width: 84; height: 30}
    a: "negar" {class: nodo; width: 100; height: 32; style.font-size: 14}
    z: END {class: extremo; width: 84; height: 30}
    i -> a: "c" {class: cond-amb}
    i -> z: "c" {class: cond-amb}
    a -> z {class: arista}
  }
}

r3: "iteración" {
  class: grupo
  label.near: top-left
  grid-columns: 3
  grid-gap: 14

  p: "programa" {
    class: panel
    label.near: top-center
    grid-columns: 1
    grid-gap: 6
    l1: "while b != 0:      ​" {class: linea}
    l2: "    a, b = b, a % b​" {class: linea}
  }
  f: "diagrama de flujo" {
    class: panel
    label.near: top-center
    direction: down
    i: "inicio" {class: extremo; width: 84; height: 30}
    c: "b ≠ 0" {class: rombo}
    a: "a, b ← b, a mod b" {class: caja}
    z: "fin" {class: extremo; width: 84; height: 30}
    i -> c {class: arista}
    c -> a: "sí" {class: arista}
    a -> c {class: arista}
    c -> z: "no" {class: arista}
  }
  g: "LangGraph" {
    class: panel
    label.near: top-center
    direction: down
    i: START {class: extremo; width: 84; height: 30}
    a: "paso" {class: nodo; width: 100; height: 32; style.font-size: 14}
    z: END {class: extremo; width: 84; height: 30}
    i -> a: "c" {class: cond-amb}
    i -> z: "c" {class: cond-amb}
    a -> a: "c" {class: cond-amb}
    a -> z: "c" {class: cond-amb}
  }
}
