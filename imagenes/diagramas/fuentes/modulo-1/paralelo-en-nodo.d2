# Lección 3, profundización. El superstep 2 del router con tres pedidos en el mismo mensaje.
# ToolNode reparte los pedidos con executor.map, un hilo por pedido; terminan en cualquier orden,
# pero la actualización trae las respuestas en el orden de los pedidos. Abajo, la diferencia con el módulo 4.
# intervalo: 2400
...@../estilo

vars: {d2-config: {layout-engine: dagre}}

classes: {
  pedido: {
    width: 230
    height: 36
    style: {fill: ${tarjeta}; stroke: ${borde-nodo}; stroke-width: 1; border-radius: 8; font: mono; font-size: 13; bold: false; font-color: ${tinta}}
  }
  pedido-activo: {
    width: 230
    height: 36
    style: {fill: ${turquesa-suave}; stroke: ${turquesa}; stroke-width: 2; border-radius: 8; font: mono; font-size: 13; bold: false; font-color: ${tinta}}
  }
  hilo: {
    shape: text
    width: 60
    style: {font: mono; font-size: 13; font-color: ${suave}}
  }
  respuesta: {
    width: 230
    height: 36
    style: {bold: false; fill: ${ambar-suave}; stroke: ${ambar}; stroke-width: 1; border-radius: 8; font: mono; font-size: 13; font-color: ${tinta}}
  }
}

grid-columns: 1
grid-gap: 18

mensaje: "s₁ · último mensaje\nia · pide derivar(x**3), integrar(x**3), resolver(x**2 - 2)" {class: msj-ia; width: 560; height: 52}

tools: "tools · superstep 2" {
  class: grupo
  label.near: top-left
  grid-columns: 3
  grid-gap: 12

  h1: "hilo 0" {class: hilo}
  p1: "derivar(x**3)" {class: pedido}
  r1: "t₁ · 3*x**2" {class: respuesta; style.opacity: 0}
  h2: "hilo 1" {class: hilo}
  p2: "integrar(x**3)" {class: pedido}
  r2: "t₂ · x**4/4" {class: respuesta; style.opacity: 0}
  h3: "hilo 2" {class: hilo}
  p3: "resolver(x**2 - 2)" {class: pedido}
  r3: "t₃ · [-sqrt(2), sqrt(2)]" {class: respuesta; style.opacity: 0}
}

u: "u = {messages: (t₁, t₂, t₃)}" {class: codigo; width: 560; height: 40; style.opacity: 0.25}

explica: "Superstep 2: tools recibe\nun mensaje con tres pedidos." {class: paso; width: 560}

steps: {
  1: {
    tools.p1.class: pedido-activo
    tools.p2.class: pedido-activo
    tools.p3.class: pedido-activo
    explica.label: "executor.map reparte un pedido por hilo:\nlos tres corren a la vez."
  }
  2: {
    tools.p3.class: pedido
    tools.r3.style.opacity: 1
    explica.label: "Terminan en cualquier orden;\naquí, resolver termina primero."
  }
  3: {
    tools.p1.class: pedido
    tools.r1.style.opacity: 1
    explica.label: "Después termina derivar."
  }
  4: {
    tools.p2.class: pedido
    tools.r2.style.opacity: 1
    explica.label: "Al final, integrar."
  }
  5: {
    u.style.opacity: 1
    u.style.stroke: ${turquesa}
    u.style.stroke-width: 2
    explica.label: "La actualización trae las respuestas en el orden\nde los pedidos, no en el que terminaron."
  }
  6: {
    explica.label: "En el módulo 4 son varios nodos en un superstep:\ncada uno escribe su u y los reducers las combinan."
  }
}
