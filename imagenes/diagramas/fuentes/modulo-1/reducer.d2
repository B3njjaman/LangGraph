# Lección 1. Cómo se aplica una actualización en Euclides: s ⊕ u, clave por clave.
# Arriba, claves sin reducer (LastValue): el valor nuevo reemplaza y la clave ausente se conserva.
# Abajo, una clave con operator.add (BinaryOperatorAggregate): las listas se concatenan.
# intervalo: 2600
...@../estilo

vars: {d2-config: {layout-engine: dagre}}

classes: {
  tabla: {
    grid-columns: 1
    grid-gap: 8
    label.near: top-center
    style: {fill: ${tarjeta}; stroke: ${borde}; stroke-width: 1; border-radius: 10; font: mono; font-size: 16; bold: true; font-color: ${tinta}}
  }
  celda: {
    width: 230
    height: 34
    style: {fill: ${nodo}; stroke: ${borde-nodo}; stroke-width: 1; border-radius: 6; font: mono; font-size: 14; bold: false; font-color: ${tinta}}
  }
  cambia: {
    width: 230
    height: 34
    style: {fill: ${turquesa-suave}; stroke: ${turquesa}; stroke-width: 2; border-radius: 6; font: mono; font-size: 14; bold: false; font-color: ${tinta}}
  }
  ausente: {
    width: 230
    height: 34
    style: {fill: ${tarjeta}; stroke: ${borde-nodo}; stroke-width: 1; stroke-dash: 3; border-radius: 6; font: mono; font-size: 14; bold: false; italic: true; font-color: ${tenue}}
  }
  operacion: {
    shape: text
    style: {font: mono; font-size: 26; font-color: ${suave}}
  }
}

grid-columns: 1
grid-gap: 26

reemplazo: "a, b sin reducer: LastValue" {
  class: grupo
  label.near: top-left
  grid-columns: 5
  grid-gap: 20

  s: "s" {
    class: tabla
    a: "a: 1071" {class: celda}
    b: "b: 462" {class: celda}
  }
  mas: "⊕" {class: operacion}
  u: "u" {
    class: tabla
    a: "a: 7" {class: celda}
    b: "b ∉ dom(u)" {class: ausente}
  }
  igual: "=" {class: operacion}
  r: "s ⊕ u" {
    class: tabla
    style.opacity: 0
    a: "a: 7" {class: cambia}
    b: "b: 462" {class: celda}
  }
}

acumulo: "cocientes con operator.add: BinaryOperatorAggregate" {
  class: grupo
  label.near: top-left
  grid-columns: 5
  grid-gap: 20

  s: "s" {
    class: tabla
    a: "a: 462" {class: celda}
    b: "b: 147" {class: celda}
    q: "cocientes: [2]" {class: celda}
  }
  mas: "⊕" {class: operacion}
  u: "u" {
    class: tabla
    a: "a: 147" {class: celda}
    b: "b: 21" {class: celda}
    q: "cocientes: [3]" {class: celda}
  }
  igual: "=" {class: operacion}
  r: "s ⊕ u" {
    class: tabla
    style.opacity: 0
    a: "a: 147" {class: cambia}
    b: "b: 21" {class: cambia}
    q: "cocientes: [2, 3]" {class: cambia}
  }
}

explica: "El nodo devuelve u. LangGraph calcula s ⊕ u con el reducer de cada clave." {class: paso; width: 640; height: 44}

steps: {
  1: {
    reemplazo.r.style.opacity: 1
    explica.label: "a está en dom(u): 7 reemplaza a 1071. b no está: conserva el 462."
  }
  2: {
    acumulo.r.style.opacity: 1
    explica.label: "Con operator.add, r(ℓ, m) = ℓ + m: la lista de cocientes se concatena."
  }
}
